		"dependency-cruiser": "^16.0.0",
		"eslint": "^10.3.0",
		"eslint-plugin-boundaries": "^6.0.2",
		"fallow": "^2.69.0",
		"supabase": "^2.98.2",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.59.3",
		"vitest": "~3.2.0",
		"wrangler": "^4.92.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "^10.53.1",
		"@supabase/supabase-js": "^2.105.4",
		"fflate": "^0.8.3",
		"groq-sdk": "^1.2.0",
		"mammoth": "^1.12.0",
		"unpdf": "^0.12.0"
	}
}