{
	"name": "prag",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"build": "wrangler deploy --dry-run",
		"lint": "eslint .",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"audit:security": "snyk test",
		"audit:health": "fallow audit",
		"arch:check": "depcruise src --config .dependency-cruiser.cjs",
